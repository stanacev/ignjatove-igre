{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/pdfjs/pdf.worker.min.mjs"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)",
          "/icons/**",
          "/media/**"
        ]
      }
    },
    {
      "name": "pdfjs",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/pdfjs/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "slike-igara",
      "urls": [
        "https://*.supabase.co/storage/v1/object/public/**",
        "https://i.ytimg.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 500,
        "maxAge": "365d"
      }
    },
    {
      "name": "podaci-igara",
      "urls": [
        "https://*.supabase.co/rest/v1/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "4s",
        "maxSize": 20,
        "maxAge": "365d"
      }
    }
  ]
}
